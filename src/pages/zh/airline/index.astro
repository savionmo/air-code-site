---
import Base from '../../../layouts/Base.astro';
import airlines from '../../../data/airlines';
const lang='zh';
const byLetter={}; for(const a of airlines){ const L=a.iata[0]; (byLetter[L] ||= []).push(a); }
const letters=Object.keys(byLetter).sort();
---
<Base title={lang==='zh'?'航空公司代码 A-Z':'Airline Codes A-Z'} lang={lang}>
<h1>{lang==='zh'?'航空公司二字码':'Airline Codes'}</h1>
<p class="muted">{airlines.length} {lang==='zh'?'家在营航空公司（OpenFlights active）':'active airlines (OpenFlights)'}</p>
<div>{letters.map(L=><a class="chip" href={`#${L}`}>{L}</a>)}</div>
{letters.map(L=><section id={L}><h3>{L}</h3><div class="grid">{byLetter[L].map(a=><a class="card" href={`/${lang}/airline/${a.iata.toLowerCase()}/`}><b>{a.iata}</b> · {a.icao}<br/>{lang==='zh'&&a.name_zh?a.name_zh:a.name_en}<br/><span class="muted">{a.country_en}</span></a>)}</div></section>)}
</Base>
