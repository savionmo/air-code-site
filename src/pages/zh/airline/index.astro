---
import Base from '../../../layouts/Base.astro';
import airlines from '../../../data/airlines';
const lang='zh';
const t=(zh,en)=>lang==='zh'?zh:en;
const byLetter={}; for(const a of airlines){ const L=(a.iata||'?')[0]; (byLetter[L] ||= []).push(a); }
const letters=Object.keys(byLetter).sort();
const aname=a=>lang==='zh'?(a.name_zh||a.name_en):a.name_en;
---
<Base title={t('航空公司代码 A-Z','Airline Codes A-Z')} lang={lang}>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span>{t('航空公司','Airlines')}</div>
<div class="phead"><h1>{t('航空公司二字码','Airline Codes')}</h1><p>{airlines.length} {t('家在营航空公司（OpenFlights）','active airlines (OpenFlights)')}</p></div>
<div class="az">{letters.map(L=><a href={`#${L}`}>{L}</a>)}</div>
{letters.map(L=>(
<section id={L}>
<div class="letter-h"><span class="L">{L}</span><span class="cnt">{byLetter[L].length} {t('家航司','airlines')}</span></div>
<div class="rows">
{byLetter[L].map(a=>(
<a class="row" href={`/${lang}/airline/${a.iata.toLowerCase()}/`}><span class="code">{a.iata}</span><span class="tt"><b>{aname(a)}</b><span>ICAO {a.icao||'-'} · {a.country_en}</span></span><span class="go">›</span></a>
))}
</div>
</section>))}
</Base>
