---
import Base from '../../../layouts/Base.astro';
import airports from '../../../data/airports';
import countryZh from '../../../data/country-zh.json';
export function getStaticPaths(){ return airports.map(a=>({ params:{ iata:a.iata.toLowerCase() }, props:{ a } })); }
const FLAG="https://cdn.jsdelivr.net/npm/flag-icons@7.5.0/flags/4x3";
const { a } = Astro.props; const lang='zh';
const t=(zh,en)=>lang==='zh'?zh:en;
const name = lang==='zh' ? (a.name_zh||a.name_en) : a.name_en;
const city = lang==='zh' ? (a.city_zh||a.city_en) : a.city_en;
const ctry = lang==='zh' ? (countryZh[a.country_code]||a.country_en) : a.country_en;
const main = a.type==='large_airport';
const sameCountry = airports.filter(x=>x.country_code===a.country_code && x.iata!==a.iata).slice(0,8);
const mapSrc=`https://www.openstreetmap.org/export/embed.html?bbox=${a.lon-0.35},${a.lat-0.22},${a.lon+0.35},${a.lat+0.22}&layer=mapnik&marker=${a.lat},${a.lon}`;
const mapLink=`https://www.openstreetmap.org/?mlat=${a.lat}&mlon=${a.lon}#map=12/${a.lat}/${a.lon}`;
const rname=x=>lang==='zh'?(x.name_zh||x.name_en):x.name_en;
const tzShow=(()=>{ if(!a.tz) return '—'; try{ const p=new Intl.DateTimeFormat('en',{timeZone:a.tz,timeZoneName:'shortOffset'}).formatToParts(); const o=(p.find(x=>x.type==='timeZoneName')||{}).value||''; return `${a.tz} (${o.replace('GMT','UTC')})`; }catch{ return a.tz; } })();
const elevShow=a.elev_ft!=null ? `${Math.round(a.elev_ft*0.3048)} ${t('米','m')} (${a.elev_ft} ft)` : '—';
const pageUrl=`https://airdocs.cn/${lang}/airport/${a.iata.toLowerCase()}/`;
const qrSrc=`https://api.qrserver.com/v1/create-qr-code/?size=132x132&margin=4&color=17242f&data=${encodeURIComponent(pageUrl)}`;
const shortTz=(()=>{ const m=tzShow.match(/\((UTC[^)]+)\)/); return m?m[1]:'—'; })();
const coordShow=`${a.lat.toFixed(4)}, ${a.lon.toFixed(4)}`;
const secName= lang==='zh' ? a.name_en : (a.name_zh||'');
const cityVal= (lang==='zh' && a.city_zh && a.city_en) ? `${a.city_zh} ${a.city_en}` : city;
const typeShow= a.type==='large_airport' ? t('主机场 · 大型机场','Main · Large airport') : a.type==='medium_airport' ? t('中型机场','Medium airport') : a.type==='small_airport' ? t('小型机场','Small airport') : t('机场','Airport');
const bars=(()=>{ let h=2166136261; const s=a.iata+(a.icao||''); for(let i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619)>>>0; } let rng=h||987654321; const rnd=()=>{ rng=(Math.imul(rng,1103515245)+12345)>>>0; return rng/4294967296; }; const out=[]; let x=0; while(x<116){ const w=[1.6,1.6,2.4,3.4,4.4][Math.floor(rnd()*5)]; out.push({x:+x.toFixed(1),w}); x+=w+[1.6,2.2,3.2][Math.floor(rnd()*3)]; } return out; })();

const rcity=x=>lang==='zh'?(x.city_zh||x.city_en):x.city_en;
const rctry=x=>lang==='zh'?(countryZh[x.country_code]||x.country_en):x.country_en;
---
<Base title={`${a.iata} ${name}`} lang={lang} description={`${a.iata} / ${a.icao} ${t('机场三字代码查询','airport code lookup')}`}>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span><a href={`/${lang}/airport/`}>{t('机场三字码','Airports')}</a><span class="sep">›</span>{a.iata}</div>

<section class="dhero">
<img class="dflag" src={`${FLAG}/${(a.country_code||'').toLowerCase()}.svg`} alt="" />
<div><h1>{name}{main&&<i class="mainbadge">{t('主机场','Main airport')}</i>}</h1><p class="dsub">{ctry}<span class="sep">·</span>{city}<span class="sep">·</span>ICAO {a.icao||'-'}</p></div>
<span class="big right">{a.iata}</span>
</section>

<div class="bp">
<div class="bpband">
<span class="bpbrand"><svg viewBox="0 0 24 24" class="bpplane" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="#fff"/></svg>AIRDOCS</span>
<span class="bpttl">· {t('登机牌 BOARDING PASS','BOARDING PASS')}</span>
{main && <span class="bppill">{t('★ 主机场','★ Main airport')}</span>}
</div>
<div class="bpbody">
<div class="bpmain">
<div class="bplab">{t('机场 AIRPORT','AIRPORT')}</div>
<div class="bphead">
<div class="bpcode">{a.iata}</div>
<div class="bpnames">
<div class="bpnm">{name}</div>
{secName && <div class="bpnm2">{secName}</div>}
<div class="bploc"><img class="bpflag" src={`${FLAG}/${(a.country_code||'').toLowerCase()}.svg`} alt="" loading="lazy" />{ctry}<span class="sep">·</span>{city}</div>
</div>
</div>
<div class="bpgrid">
<div class="bpf"><span>{t('ICAO 四字码','ICAO')}</span><b>{a.icao||'-'}</b></div>
<div class="bpf"><span>{t('城市 CITY','CITY')}</span><b>{cityVal}</b></div>
<div class="bpf"><span>{t('国家 COUNTRY','COUNTRY')}</span><b>{ctry} ({a.country_code})</b></div>
<div class="bpf"><span>{t('时区 TIME ZONE','TIME ZONE')}</span><b>{tzShow}</b></div>
<div class="bpf"><span>{t('海拔 ELEVATION','ELEVATION')}</span><b>{elevShow}</b></div>
<div class="bpf"><span>{t('经纬度 COORDINATES','COORDINATES')}</span><b>{coordShow}</b></div>
</div>
<div class="bpfoot">
<div class="bpbc"><svg viewBox="0 0 120 34" preserveAspectRatio="none" class="bpbars" fill="#17242F" aria-hidden="true">{bars.map(b=><rect x={b.x} width={b.w} height="34"/>)}</svg><div class="bpbcap">{a.iata} {a.icao||''} · AIRDOCS.CN</div></div>
{a.home && <a class="bphome" href={a.home} target="_blank" rel="noopener">{t('访问官网 →','Visit website →')}</a>}
</div>
</div>
<aside class="bpstub">
<div class="bplab">{t('存根 STUB','STUB')}</div>
<div class="bpscode">{a.iata}<span>{a.icao||''}</span></div>
<div class="bpsgrid">
<div class="bpf"><span>{t('国家 COUNTRY','COUNTRY')}</span><b>{ctry} ({a.country_code})</b></div>
<div class="bpf"><span>{t('时区 ZONE','ZONE')}</span><b>{shortTz}</b></div>
<div class="bpf bpwide"><span>{t('类型 TYPE','TYPE')}</span><b>{typeShow}</b></div>
</div>
<div class="bpqr">
<img src={qrSrc} alt={t('本页二维码','QR code for this page')} loading="lazy" onerror="this.parentElement.style.display='none'" />
<div class="bpqrt"><b>{t('扫码打开','Scan to open')}</b><span>{t('本机场页面','this airport page')}</span><i>AIRDOCS.CN/{a.iata}</i></div>
</div>
</aside>
</div>
</div>

<div class="sec-head"><h2>{t('位置地图','Map')}</h2><a class="more" href={mapLink} target="_blank" rel="noopener">{t('查看大图 →','Open larger map →')}</a></div>
<div class="card" style="margin:0;padding:8px"><iframe title={t('机场位置地图','Airport map')} src={mapSrc} style="width:100%;height:320px;border:0;border-radius:10px;display:block" loading="lazy"></iframe></div>

{sameCountry.length>0 && (
<div><div class="sec-head"><h2>{t('同国家其他机场','More airports in '+a.country_en)}</h2><a class="more" href={`/${lang}/airport/`}>{t('全部机场 →','All airports →')}</a></div>
{sameCountry.map(x=>(
<a class="apcard" href={`/${lang}/airport/${x.iata.toLowerCase()}/`}>
<img class="flag" src={`${FLAG}/${(x.country_code||'').toLowerCase()}.svg`} alt="" loading="lazy" />
<span class="apinfo">
<span class="nm">{rname(x)}{x.type==='large_airport'&&<i class="mainbadge">{t('主机场','Main airport')}</i>}</span>
<span class="en">{x.name_en}</span>
<span class="loc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>{rctry(x)} · {rcity(x)}</span>
</span>
<span class="apcode"><b>{x.iata}</b><i>{x.icao||''}</i></span>
<span class="go">›</span>
</a>
))}
</div>
)}
</Base>
