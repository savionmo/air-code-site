---
import Base from '../../../layouts/Base.astro';
import airports from '../../../data/airports';
export function getStaticPaths(){ return airports.map(a=>({ params:{ iata:a.iata.toLowerCase() }, props:{ a } })); }
const { a } = Astro.props; const lang='zh';
const t=(zh,en)=>lang==='zh'?zh:en;
const name = lang==='zh' ? (a.name_zh||a.name_en) : a.name_en;
const city = lang==='zh' ? (a.city_zh||a.city_en) : a.city_en;
const sameCountry = airports.filter(x=>x.country_code===a.country_code && x.iata!==a.iata).slice(0,8);
const mapSrc=`https://www.openstreetmap.org/export/embed.html?bbox=${a.lon-0.35},${a.lat-0.22},${a.lon+0.35},${a.lat+0.22}&layer=mapnik&marker=${a.lat},${a.lon}`;
const mapLink=`https://www.openstreetmap.org/?mlat=${a.lat}&mlon=${a.lon}#map=12/${a.lat}/${a.lon}`;
---
<Base title={`${a.iata} ${name}`} lang={lang} description={`${a.iata} / ${a.icao} ${t('机场三字代码查询','airport code lookup')}`}>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span><a href={`/${lang}/airport/`}>{t('机场三字码','Airports')}</a><span class="sep">›</span>{a.iata}</div>
<section class="dhero">
<span class="big">{a.iata}</span>
<div><h1>{name}</h1><p>{city} · {a.country_en} · ICAO {a.icao}</p></div>
</section>
<div class="kv">
<div class="kvr"><span class="k">IATA</span><b>{a.iata}</b></div>
<div class="kvr"><span class="k">ICAO</span><b>{a.icao}</b></div>
<div class="kvr"><span class="k">{t('英文名','Name (EN)')}</span>{a.name_en}</div>
<div class="kvr"><span class="k">{t('中文名','Name (ZH)')}</span>{a.name_zh || t('暂无中文名，保留英文','To be added')}</div>
<div class="kvr"><span class="k">{t('城市','City')}</span>{city}{lang==='zh'&&a.city_zh&&a.city_en!==a.city_zh?` / ${a.city_en}`:''}</div>
<div class="kvr"><span class="k">{t('国家','Country')}</span>{a.country_en} ({a.country_code})</div>
<div class="kvr"><span class="k">{t('经纬度','Coordinates')}</span>{a.lat}, {a.lon}</div>
<div class="kvr"><span class="k">{t('类型','Type')}</span>{a.type}</div>
</div>
<div class="sec-head"><h2>{t('位置地图','Map')}</h2><a class="more" href={mapLink} target="_blank" rel="noopener">{t('查看大图 →','Open larger map →')}</a></div>
<div class="card" style="margin:0;padding:8px"><iframe title={t('机场位置地图','Airport map')} src={mapSrc} style="width:100%;height:320px;border:0;border-radius:10px;display:block" loading="lazy"></iframe></div>
{sameCountry.length>0 && (
<div><div class="sec-head"><h2>{t('同国家其他机场','More in '+a.country_en)}</h2><a class="more" href={`/${lang}/airport/`}>{t('全部机场 →','All airports →')}</a></div>
<div class="rows">
{sameCountry.map(x=>(
<a class="row" href={`/${lang}/airport/${x.iata.toLowerCase()}/`}><span class="code sm">{x.iata}</span><span class="tt"><b>{lang==='zh'?(x.name_zh||x.name_en):x.name_en}</b><span>{lang==='zh'?(x.city_zh||x.city_en):x.city_en}</span></span><span class="go">›</span></a>
))}
</div></div>
)}
<p class="muted" style="font-size:13px;margin-top:16px">{t('跑道、航站楼等扩展字段后续接入 OurAirports runways 数据。','Runways and terminals to be added from OurAirports runways data.')}</p>
</Base>
