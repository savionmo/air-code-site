---
import Base from '../../../../../layouts/Base.astro';
import fleet from '../../../../../data/cargo-fleet.json';
import ulds from '../../../../../data/ulds.json';
export function getStaticPaths(){
  const paths=[];
  for(const f of fleet){
    for(const u of ulds.filter(x=>(x.airline||'').toLowerCase()===f.airline.toLowerCase())){
      paths.push({ params:{ airline:f.airline.toLowerCase(), code:u.code.toLowerCase() }, props:{ f, u } });
    }
  }
  return paths;
}
const { f, u } = Astro.props; const lang='zh';
const t=(zh,en)=>lang==='zh'?zh:en;
const aname=lang==='zh'?f.airline_zh:f.airline_en;
const catZh={container:t('集装箱','Container'),pallet:t('集装板','Pallet'),special:t('特殊集装器','Special ULD')};
const dims=u.dims_cm.join(' × ')+' cm';
const tare=Array.isArray(u.tare_kg)?u.tare_kg.join(' ~ ')+' kg':u.tare_kg+' kg';
const [L,W,H]=u.dims_cm; const sx=340/Math.max(L,W);
const bw=(W*sx).toFixed(0), bl=(L*sx).toFixed(0);
const alb=f.airline.toLowerCase();
---
<Base title={`${u.code} ${t('集装器规格','ULD Specs')} | ${aname}`} lang={lang} description={`${aname} ${u.code}${t('集装器规格','ULD specs')}`}>
<style>
:global(.crumbs){font-size:13px;color:var(--muted);margin:2px 0 12px}
:global(.crumbs a){color:var(--fb)}:global(.crumbs .sep){margin:0 6px}
:global(.uhero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:24px 22px;margin:2px 0 18px;color:#fff;box-shadow:0 8px 24px rgba(11,76,184,.3);display:flex;align-items:center;gap:16px}
:global(.ucode){flex:none;background:#fff;color:var(--fb);font-weight:800;font-size:26px;border-radius:12px;padding:10px 16px}
:global(.uhero h1){margin:0 0 4px;font-size:22px}
:global(.uhero .sub){margin:0;opacity:.9;font-size:13.5px}
:global(.kv){background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:16px}
:global(.kvr){display:flex;gap:12px;padding:11px 16px;border-bottom:1px solid #F4F6F8;font-size:14px;align-items:baseline}
:global(.kvr:last-child){border-bottom:0}
:global(.kvr .k){flex:none;width:130px;color:var(--muted);font-size:13px}
:global(.sec-head){margin:20px 0 12px}:global(.sec-head h2){margin:0;font-size:18px;display:flex;align-items:center;gap:10px}
:global(.sec-head h2 .bar){width:5px;height:20px;border-radius:3px;background:var(--fb)}
:global(.card){background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 1px 3px rgba(16,24,40,.06);margin-bottom:16px}
:global(.dimbox){display:flex;justify-content:center;padding:8px}
:global(.dimbox svg){max-width:100%;height:auto}
:global(.dimbox rect){fill:#DCEBFF;stroke:#1F8BF7;stroke-width:2}
:global(.dimbox text){fill:#0A46A8;font-size:12px;font-weight:700}
:global(.acchips){display:flex;flex-wrap:wrap;gap:8px}
:global(.acchip){background:#EEF4FF;color:#0A46A8;font-weight:700;font-size:13px;padding:6px 14px;border-radius:999px}
:global(table.spec){width:100%;border-collapse:collapse;font-size:13.5px}
:global(table.spec td){padding:9px 12px;border-top:1px solid #EEF1F5}
:global(table.spec tr:first-child td){border-top:0}
:global(.srcnote){font-size:12.5px;color:var(--muted);margin-top:16px}
:global(.srcnote a){color:var(--fb)}
</style>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span><a href={`/${lang}/cargo/`}>{t('货机资料','Cargo Data')}</a><span class="sep">›</span><a href={`/${lang}/cargo/${alb}/`}>{f.airline}</a><span class="sep">›</span><a href={`/${lang}/cargo/${alb}/uld/`}>{t('集装器','ULDs')}</a><span class="sep">›</span>{u.code}</div>
<section class="uhero"><span class="ucode">{u.code}</span><div><h1>{catZh[u.cat]}{u.aka?` (${u.aka})`:''}</h1><p class="sub">{aname} · {lang==='zh'?u.desc_zh:u.desc_en}</p></div></section>

<div class="sec-head"><h2><span class="bar"></span>{t('外形示意','Dimensions')}</h2></div>
<div class="card"><div class="dimbox">
<svg viewBox={`0 0 ${+bw+90} ${+bl+40}`} role="img" aria-label="dimensions">
<rect x="45" y="20" width={bw} height={bl} rx="4"/>
<text x="45" y="12">{u.dims_cm[0]} cm</text>
<text x={+bw+52} y={+20+(+bl)/2}>{u.dims_cm[1]} cm</text>
{u.dims_cm[2] && (<text x="45" y={+20+(+bl)+24}>{t('高','H')} {u.dims_cm[2]} cm</text>)}
</svg></div></div>

<div class="sec-head"><h2><span class="bar"></span>{t('规格','Specifications')}</h2></div>
<div class="kv">
<div class="kvr"><span class="k">{t('外形尺寸','External dims')}</span><b>{dims}</b></div>
{u.door_cm && (<div class="kvr"><span class="k">{t('门尺寸','Door')}</span><b>{u.door_cm.join(' × ')} cm</b></div>)}
{u.volume_m3 && (<div class="kvr"><span class="k">{t('内容积','Volume')}</span><b>{u.volume_m3} m³</b></div>)}
<div class="kvr"><span class="k">{t('自重','Tare')}</span><b>{tare}</b></div>
<div class="kvr"><span class="k">{t('重量限制（含自重）','Weight limit (incl. tare)')}</span><b>{u.max_gross_kg?u.max_gross_kg.toLocaleString()+' kg':'—'}</b></div>
</div>

{u.limits && (<div><div class="sec-head"><h2><span class="bar"></span>{t('分机型重量限制','Limits by Aircraft')}</h2></div>
<div class="card" style="padding:0;overflow:hidden"><table class="spec">
{u.limits.map(l=>(<tr><td><b>{l.for}</b></td><td style="text-align:right">{l.kg} kg</td></tr>))}
</table></div></div>)}

<div class="sec-head"><h2><span class="bar"></span>{t('适用机型','Compatible Aircraft')}</h2></div>
<div class="card"><div class="acchips">{u.aircraft.map(a=>(<span class="acchip">{a}</span>))}</div></div>

<p class="srcnote">{t('数据引自','Data from')} <a href={u.src} target="_blank" rel="noopener">{aname} Cargo {t('官网公开资料','official public specs')}</a></p>
</Base>
