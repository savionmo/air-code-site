---
import Base from '../../../layouts/Base.astro';
import news from '../../../data/news.json';
const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
const list = news.filter(n=>n.lang===lang);
const items = list.length?list:news;
---
<Base title={t('资讯','News')} lang={lang} description={t('机场代码科普、航线动态与行业资讯。','Airport code guides, route news and industry updates.')}>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span>{t('资讯','News')}</div>
<div class="phead"><h1>{t('资讯文章','News & Guides')}</h1><p>{t('机场代码科普 · 航线动态 · 行业资讯','Code guides · route news · industry updates')}</p></div>
<div class="rows">
{items.map(n=>{ const [y,m,d]=n.date.split('-'); return (
<a class="newsrow" href={`/${lang}/news/${n.slug}/`}><span class="datebox"><b>{d}</b><span>{y}-{m}</span></span><span class="tt"><b>{n.title}</b><p>{n.description}</p></span><span class="go">›</span></a>
)})}
</div>
</Base>
