---
import Base from '../../../layouts/Base.astro';
import airlines from '../../../data/airlines';
import countries from '../../../data/countries.json';
import countryZh from '../../../data/country-zh.json';
const FLAG="https://cdn.jsdelivr.net/npm/flag-icons@7.5.0/flags/4x3";
const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
const en2cc={}; for(const [cc,en] of Object.entries(countries)) en2cc[en]=cc.toLowerCase();
const data=airlines.map(a=>{const cc=en2cc[a.country_en]||'';return{i:a.iata,o:a.icao||'',zh:a.name_zh||'',en:a.name_en,cc,cn:countryZh[cc.toUpperCase()]||a.country_en||'',ce:a.country_en||'',cs:a.callsign||''};});
const hot=['CA','MU','CZ','AA','BA','LH','EK','SQ','NH','JL'];
const hotA=hot.map(h=>data.find(a=>a.i===h)).filter(Boolean);
const PIN='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>';
---
<Base title={t('航空公司二字码查询_航司代码大全','Airline Code Lookup')} lang={lang} description={t('全球航空公司二字码(IATA)、三字码(ICAO)查询：航司中英文名称、呼号、所属国家。','Look up airline IATA/ICAO codes worldwide.')}>
<style>
:global(.apt-hero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:26px 22px 22px;margin:2px 0 18px;box-shadow:0 8px 24px rgba(11,76,184,.3);color:#fff}
:global(.apt-crumbs){font-size:13px;color:rgba(255,255,255,.85);margin-bottom:10px}
:global(.apt-crumbs a){color:#fff}
:global(.apt-hero h1){margin:0 0 6px;font-size:27px;letter-spacing:1px}
:global(.apt-hero .sub){margin:0 0 16px;opacity:.92;font-size:14px}
:global(.capsule){display:flex;background:#fff;border-radius:999px;padding:6px;box-shadow:0 4px 16px rgba(0,0,0,.16);max-width:560px}
:global(.capsule input){flex:1;min-width:0;border:0;outline:none;font-size:15.5px;padding:10px 16px;border-radius:999px;background:transparent}
:global(.capsule button){flex:none;border:0;background:var(--fb);color:#fff;font-size:15.5px;font-weight:700;padding:10px 30px;border-radius:999px;cursor:pointer}
:global(.capsule button:hover){background:var(--fb-dark)}
:global(.hotq){margin-top:12px;font-size:13.5px;color:rgba(255,255,255,.9);display:flex;flex-wrap:wrap;gap:8px;align-items:center}
:global(.hotq b){font-weight:600}
:global(.hotq a){color:#fff;background:rgba(255,255,255,.18);padding:4px 12px;border-radius:999px;font-size:13px}
:global(.hotq a:hover){background:#fff;color:var(--fb);text-decoration:none}
:global(.pager){display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:18px 0 6px;align-items:center}
:global(.pg){min-width:36px;text-align:center;padding:7px 10px;border:1px solid var(--line);background:#fff;border-radius:9px;font-size:13.5px;color:var(--ink);cursor:pointer;font-weight:600}
:global(.pg.on){background:var(--fb);border-color:var(--fb);color:#fff}
:global(.pg:hover){border-color:var(--fb);color:var(--fb)}
:global(.pg.on:hover){color:#fff}
:global(.pg.dis){opacity:.4;pointer-events:none}
:global(.pginfo){font-size:13px;color:var(--muted);width:100%;text-align:center;margin-top:2px}
:global(.emptycard){background:#fff;border:1px solid var(--line);border-radius:16px;padding:34px;text-align:center;color:var(--muted)}
:global(.sidecard){background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
:global(.sidecard h3){margin:0 0 10px;font-size:15.5px;display:flex;align-items:center;gap:8px}
:global(.sidecard h3::before){content:"";width:4px;height:16px;border-radius:2px;background:var(--fb)}
:global(.sidelink){display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid #F4F6F8;font-size:14px;color:var(--ink)}
:global(.sidelink:last-child){border-bottom:0}
:global(a.sidelink:hover){color:var(--fb);text-decoration:none}
:global(.sflag){width:26px;height:18px;object-fit:cover;border-radius:4px;flex:none;box-shadow:0 1px 2px rgba(0,0,0,.15);background:#eef1f5}
:global(.mfrb){width:64px;height:44px;flex:none;border-radius:8px;background:linear-gradient(135deg,#1F8BF7,#0A46A8);color:#fff;font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.18)}
:global(.apt-cols){display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}
@media(max-width:900px){:global(.apt-cols){grid-template-columns:1fr}:global(.apt-side){display:grid;grid-template-columns:1fr 1fr;gap:14px}:global(.apt-side .sidecard){margin-bottom:0}}
@media(max-width:600px){:global(.apt-side){grid-template-columns:1fr}:global(.apt-hero h1){font-size:23px}:global(.capsule button){padding:10px 20px}:global(.mfrb){width:48px;height:34px;font-size:18px}}
</style>

<section class="apt-hero">
<div class="apt-crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a> › {t('航空公司','Airlines')}</div>
<h1>{t('航空公司二字码查询','Airline Code Lookup')}</h1>
<p class="sub">{t('全球航司 IATA 二字码 · ICAO 三字码查询','Worldwide airline IATA / ICAO code lookup')}</p>
<div class="capsule"><input id="aq" type="search" placeholder={t('输入二字码 / 航司中文名 / 英文名，如 CA、国航、Air China','Code / airline name, e.g. CA, Air China')} autocomplete="off" /><button id="ago">{t('查询','Search')}</button></div>
<div class="hotq"><b>{t('热门查询：','Popular:')}</b>{hot.map(c=><a href={`/${lang}/airline/${encodeURIComponent(c.toLowerCase())}/`}>{c}</a>)}</div>
</section>

<div class="apt-cols">
<div class="apt-main">
<div class="listhead"><h2><span class="bar"></span><span id="ltitle">{t('全部航空公司','All Airlines')}</span></h2>
<select class="sortsel" id="asort"><option value="d">{t('⇅ 默认排序','⇅ Default')}</option><option value="i">{t('⇅ 按二字码','⇅ By IATA')}</option><option value="c">{t('⇅ 按国家','⇅ By country')}</option></select></div>
<div id="alist"></div>
<div class="pager" id="apager"></div>
</div>
<aside class="apt-side">
<div class="sidecard"><h3>{t('热门航司','Popular Airlines')}</h3>
{hotA.map(a=><a class="sidelink" href={`/${lang}/airline/${encodeURIComponent(a.i.toLowerCase())}/`}>{a.cc&&<img class="sflag" src={`${FLAG}/${a.cc}.svg`} alt="" loading="lazy" />}<span class="code sm">{a.i}</span>{lang==='zh'?(a.zh||a.en):a.en}</a>)}
</div>
<div class="sidecard"><h3>{t('说明','Note')}</h3><p class="muted" style="font-size:13px;margin:0">{t('二字码为 IATA 航司代码，三字码为 ICAO 代码。数据来自 OpenFlights，部分小型航司中文名暂缺。','IATA 2-letter and ICAO 3-letter airline codes. Data from OpenFlights.')}</p></div>
</aside>
</div>

<script define:vars={{ DATA:data, lang, PIN, FLAG }}>
const PER=15; let q='', page=1, sort='d';
const $=id=>document.getElementById(id);
const T=(zh,en)=>lang==='zh'?zh:en;
const params=new URLSearchParams(location.search);q=params.get('q')||'';
if(q){$('aq').value=q;}
function match(x){ const nq=q.trim().toLowerCase(); if(!nq)return true; return [x.i,x.o,x.zh,x.en,x.cn,x.ce,x.cs].join(' ').toLowerCase().includes(nq); }
function card(x){
  const url=`/${lang}/airline/${encodeURIComponent(x.i.toLowerCase())}/`;
  const nm=lang==='zh'?(x.zh||x.en):x.en;
  const loc=lang==='zh'?x.cn:x.ce;
  const flag=x.cc?`<img class="flag" src="${FLAG}/${x.cc}.svg" alt="" loading="lazy">`:`<span class="mfrb">✈</span>`;
  return `<a class="apcard" href="${url}">${flag}`+
  `<span class="apinfo"><span class="nm">${nm}</span>`+
  `<span class="en">${x.en}</span>${loc?`<span class="loc">${PIN}${loc}</span>`:''}</span>`+
  `<span class="apcode"><b>${x.i}</b><i>${x.o||''}</i></span><span class="go">›</span></a>`;
}
function render(){
  let list=DATA.filter(match);
  if(sort==='i')list=[...list].sort((a,b)=>a.i<b.i?-1:1);
  else if(sort==='c')list=[...list].sort((a,b)=>((lang==='zh'?a.cn:a.ce)+a.i)<((lang==='zh'?b.cn:b.ce)+b.i)?-1:1);
  const pages=Math.max(1,Math.ceil(list.length/PER));
  if(page>pages)page=pages;
  const s=(page-1)*PER, rows=list.slice(s,s+PER);
  $('alist').innerHTML=rows.length?rows.map(card).join(''):`<div class="emptycard">${T('没有找到匹配的航空公司，换个关键词试试','No matching airlines — try another keyword')}</div>`;
  $('ltitle').textContent=(q?T(`“${q.trim()}”的搜索结果`, `Results for "${q.trim()}"`):T('全部航空公司','All Airlines'))+`（${list.length}）`;
  let h=`<button class="pg${page===1?' dis':''}" data-p="${page-1}">${T('上一页','Prev')}</button>`;
  const win=[]; for(let p=1;p<=pages;p++){ if(p===1||p===pages||Math.abs(p-page)<=2) win.push(p); }
  let last=0; for(const p of win){ if(p-last>1)h+=`<span style="color:var(--muted)">…</span>`; h+=`<button class="pg${p===page?' on':''}" data-p="${p}">${p}</button>`; last=p; }
  h+=`<button class="pg${page===pages?' dis':''}" data-p="${page+1}">${T('下一页','Next')}</button>`;
  h+=`<span class="pginfo">${T('共','')}${list.length}${T(' 家',' results')} · ${T('第','Page')} ${page}/${pages} ${T('页','')}</span>`;
  $('apager').innerHTML=h;
}
$('apager').addEventListener('click',e=>{ const b=e.target.closest('button[data-p]'); if(!b||b.classList.contains('dis'))return; page=+b.dataset.p; render(); window.scrollTo({top:0,behavior:'smooth'}); });
$('asort').addEventListener('change',e=>{ sort=e.target.value; page=1; render(); });
function doSearch(v){ q=v; page=1; render(); }
$('aq').addEventListener('input',e=>doSearch(e.target.value));
$('ago').addEventListener('click',()=>doSearch($('aq').value));
render();
</script>
</Base>
