---
import Base from '../../../layouts/Base.astro';
import fleet from '../../../data/cargo-fleet.json';
import ulds from '../../../data/ulds.json';
export function getStaticPaths(){ return fleet.map(f=>({ params:{ airline:f.airline.toLowerCase() }, props:{ f } })); }
const { f } = Astro.props; const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
const name=lang==='zh'?f.airline_zh:f.airline_en;
const freighters=f.aircraft.filter(a=>a.freighter);
const pax=f.aircraft.filter(a=>!a.freighter);
const ucnt=ulds.filter(u=>(u.airline||'').toLowerCase()===f.airline.toLowerCase()).length;
const acard=a=>`
<a class="alcard" href="/${lang}/cargo/${f.airline.toLowerCase()}/${a.code}/">
<span class="alcode">${a.freighter?'✈':'🛩'}</span>
<span class="alinfo"><span class="nm">${lang==='zh'?a.type_zh:a.type_en}</span>
<span class="meta">${a.holds.map(h=>`${h.zh}: ${h.capacity}`).slice(0,2).join(' · ')}</span></span>
<span class="go">›</span></a>`;
---
<Base title={`${name}${t('货机资料_货舱布局与集装器配置',' Cargo Data, Hold Layouts & ULD Configs')}`} lang={lang} description={`${name}${t('货机机型、货舱布局、集装器配置',' freighter types, hold layouts, ULD configs')}`}>
<style>
:global(.crumbs){font-size:13px;color:var(--muted);margin:2px 0 12px}
:global(.crumbs a){color:var(--fb)}:global(.crumbs .sep){margin:0 6px}
:global(.alhero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:24px 22px;margin:2px 0 18px;color:#fff;box-shadow:0 8px 24px rgba(11,76,184,.3)}
:global(.alhero h1){margin:0 0 6px;font-size:25px}
:global(.alhero .sub){margin:0;opacity:.9;font-size:13.5px}
:global(.alhero .sub a){color:#fff;text-decoration:underline}
:global(.sec-head){margin:20px 0 12px}:global(.sec-head h2){margin:0;font-size:18px;display:flex;align-items:center;gap:10px}
:global(.sec-head h2 .bar){width:5px;height:20px;border-radius:3px;background:var(--fb)}
:global(.alcard){display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:12px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
:global(a.alcard:hover){border-color:var(--fb);text-decoration:none}
:global(.alcode){flex:none;width:52px;height:52px;border-radius:12px;background:#EEF4FF;display:flex;align-items:center;justify-content:center;font-size:24px}
:global(.alinfo .nm){font-size:16.5px;font-weight:700}
:global(.alinfo .meta){display:block;font-size:13px;color:var(--muted);margin-top:4px}
:global(.go){margin-left:auto;color:var(--muted);font-size:22px}
:global(.more){font-size:13px;color:var(--fb)}
:global(.srcnote){font-size:12.5px;color:var(--muted);margin-top:18px}
:global(.srcnote a){color:var(--fb)}
</style>
<div class="crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a><span class="sep">›</span><a href={`/${lang}/cargo/`}>{t('货机资料','Cargo Data')}</a><span class="sep">›</span>{f.airline}</div>
<section class="alhero">
<h1>{name} <span style="font-size:15px;opacity:.85">{t('货机资料','Cargo Data')}</span></h1>
<p class="sub">{t('机型货舱布局 · 集装器配置 · 数据来源','Hold layouts · ULD configs · Source')}: <a href={f.src} target="_blank" rel="noopener">{f.airline_en} Cargo</a> · {t('核查','Checked')} {f.checked_at}</p>
</section>
{freighters.length>0 && (<div><div class="sec-head"><h2><span class="bar"></span>{t('货机','Freighters')}</h2></div><div set:html={freighters.map(acard).join('')}></div></div>)}
{pax.length>0 && (<div><div class="sec-head"><h2><span class="bar"></span>{t('客机（腹舱）','Passenger Aircraft (Belly)')}</h2></div><div set:html={pax.map(acard).join('')}></div></div>)}
{ucnt>0 && (<div><div class="sec-head"><h2><span class="bar"></span>{t('集装器','ULDs')}</h2><a class="more" href={`/${lang}/cargo/${f.airline.toLowerCase()}/uld/`}>{t('全部 →','All →')}</a></div>
<a class="alcard" href={`/${lang}/cargo/${f.airline.toLowerCase()}/uld/`}>
<span class="alcode">📦</span>
<span class="alinfo"><span class="nm">{t('集装器库','ULD Library')}</span>
<span class="meta">{ucnt} {t('种集装器','ULD types')}</span></span>
<span class="go">›</span></a></div>)}
<p class="srcnote">{t('规格数据引自各航空公司官网公开资料，仅供参考，实际装载以航司最新规定为准。','Specs from airlines’ official public sources, for reference only; actual loading per the airline’s latest rules.')}</p>
</Base>
