---
import Base from '../../../layouts/Base.astro';
import fleet from '../../../data/cargo-fleet.json';
const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
---
<Base title={t('货机资料_按航空公司查询','Cargo Data by Airline')} lang={lang} description={t('按航空公司查询货机机型、货舱布局与集装器配置，集装器规格库。','Cargo aircraft, hold layouts and ULD configurations by airline. ULD spec library.')}>
<style>
:global(.apt-hero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:26px 22px 22px;margin:2px 0 18px;box-shadow:0 8px 24px rgba(11,76,184,.3);color:#fff}
:global(.apt-crumbs){font-size:13px;color:rgba(255,255,255,.85);margin-bottom:10px}
:global(.apt-crumbs a){color:#fff}
:global(.apt-hero h1){margin:0 0 6px;font-size:27px;letter-spacing:1px}
:global(.apt-hero .sub){margin:0;opacity:.92;font-size:14px}
:global(.sec-head){display:flex;align-items:center;justify-content:space-between;margin:22px 0 12px}
:global(.sec-head h2){margin:0;font-size:19px;display:flex;align-items:center;gap:10px}
:global(.sec-head h2 .bar){width:5px;height:20px;border-radius:3px;background:var(--fb)}
:global(.alcard){display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:12px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
:global(a.alcard:hover){border-color:var(--fb);text-decoration:none}
:global(.alcode){flex:none;min-width:64px;text-align:center;background:linear-gradient(135deg,#1F8BF7,#0A46A8);color:#fff;font-weight:800;font-size:20px;border-radius:10px;padding:10px 8px}
:global(.alinfo .nm){font-size:17px;font-weight:700}
:global(.alinfo .en){font-size:13px;color:var(--muted)}
:global(.alinfo .meta){font-size:13px;color:var(--muted);margin-top:4px}
:global(.go){margin-left:auto;color:var(--muted);font-size:22px}
@media(max-width:600px){</style>

<section class="apt-hero">
<div class="apt-crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a> › {t('货机资料','Cargo Data')}</div>
<h1>{t('货机资料','Cargo Data')}</h1>
<p class="sub">{t('按航空公司查货机机型 · 货舱布局 · 集装器配置，附集装器规格库','Aircraft, hold layouts & ULD configs by airline, plus a ULD spec library')}</p>
</section>

<div class="sec-head"><h2><span class="bar"></span>{t('按航空公司','By Airline')}</h2></div>
{fleet.map(f=>{const al=f.airline;return (
<a class="alcard" href={`/${lang}/cargo/${al.toLowerCase()}/`}>
<span class="alcode">{al}</span>
<span class="alinfo"><span class="nm">{lang==='zh'?f.airline_zh:f.airline_en}</span><span class="en"> · {lang==='zh'?f.airline_en:f.airline_zh}</span>
<span class="meta">{t('货机','Freighters')} {f.aircraft.filter(a=>a.freighter).length} · {t('机型','Types')} {f.aircraft.length} · {t('核查','Checked')} {f.checked_at}</span></span>
<span class="go">›</span></a>);})}

</Base>
