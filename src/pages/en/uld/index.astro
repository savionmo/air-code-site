---
import Base from '../../../layouts/Base.astro';
import ulds from '../../../data/ulds.json';
const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
const cats=[['container',t('集装箱','Containers'),t('箱式集装器，带门，可上锁','Enclosed ULDs with doors')],['pallet',t('集装板','Pallets'),t('平板集装器，配网罩使用','Flat ULDs used with nets')],['special',t('特殊集装器','Special ULDs'),t('温控、重型等特种集装器','Temperature-controlled & heavy-duty units')]];
const fmt=u=>u.tare_kg?(Array.isArray(u.tare_kg)?u.tare_kg.join('~'):u.tare_kg)+' kg':'—';
---
<Base title={t('集装器规格库_ULD 查询','ULD Spec Library')} lang={lang} description={t('集装箱、集装板、特殊集装器规格：尺寸、自重、最大毛重、适用机型。','Container, pallet and special ULD specs: dimensions, tare, max gross, compatible aircraft.')}>
<style>
:global(.apt-hero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:26px 22px 22px;margin:2px 0 18px;box-shadow:0 8px 24px rgba(11,76,184,.3);color:#fff}
:global(.apt-crumbs){font-size:13px;color:rgba(255,255,255,.85);margin-bottom:10px}
:global(.apt-crumbs a){color:#fff}
:global(.apt-hero h1){margin:0 0 6px;font-size:27px;letter-spacing:1px}
:global(.apt-hero .sub){margin:0;opacity:.92;font-size:14px}
:global(.ctabs){display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 4px}
:global(.ctab){border:1px solid var(--line);background:#fff;color:var(--ink);font-size:14px;font-weight:600;padding:8px 16px;border-radius:999px;cursor:pointer;text-decoration:none}
:global(.ctab small){font-weight:400;color:var(--muted);margin-left:4px}
:global(.sec-head){margin:22px 0 12px}:global(.sec-head h2){margin:0;font-size:18px}
:global(.sec-head p){margin:4px 0 0;font-size:13px;color:var(--muted)}
:global(.uldgrid){display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
:global(.ucard){background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
:global(a.ucard:hover){border-color:var(--fb);text-decoration:none}
:global(.ucard .code){font-size:20px;font-weight:800;color:var(--fb)}
:global(.ucard .nm){font-size:13.5px;font-weight:600;margin:4px 0 8px}
:global(.ucard .sp){font-size:12.5px;color:var(--muted);line-height:1.7}
@media(max-width:700px){:global(.uldgrid){grid-template-columns:1fr 1fr}}
@media(max-width:460px){:global(.uldgrid){grid-template-columns:1fr}}
</style>
<section class="apt-hero">
<div class="apt-crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a> › {t('集装器','ULDs')}</div>
<h1>{t('集装器规格库','ULD Spec Library')}</h1>
<p class="sub">{t('集装箱 · 集装板 · 特殊集装器：外形尺寸、自重、重量限制、适用机型','Containers · Pallets · Special ULDs: dimensions, tare, limits, compatible aircraft')}</p>
</section>
<div class="ctabs">{cats.map(([k,label])=>(<a class="ctab" href={`#${k}`}>{label}<small>{ulds.filter(u=>u.cat===k).length}</small></a>))}</div>
{cats.map(([k,label,desc])=>(
<div id={k}><div class="sec-head"><h2>{label}</h2><p>{desc}</p></div>
<div class="uldgrid">{ulds.filter(u=>u.cat===k).map(u=>(
<a class="ucard" href={`/${lang}/uld/${u.code.toLowerCase()}/`}>
<div class="code">{u.code}</div><div class="nm">{u.aka?u.aka+' · ':''}{lang==='zh'?u.desc_zh:u.desc_en}</div>
<div class="sp">{u.dims_cm.join(' × ')} cm<br/>{t('自重','Tare')} {fmt(u)} · {t('限重','Limit')} {u.max_gross_kg?u.max_gross_kg.toLocaleString()+' kg':'—'}</div>
</a>))}</div></div>))}
</Base>
