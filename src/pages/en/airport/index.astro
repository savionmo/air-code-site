---
import Base from '../../../layouts/Base.astro';
import airports from '../../../data/airports';
import newsAll from '../../../data/news.json';
import countryZh from '../../../data/country-zh.json';
const lang='en';
const t=(zh,en)=>lang==='zh'?zh:en;
const CONT=[['all',t('全部','All')],['AS',t('亚洲','Asia')],['EU',t('欧洲','Europe')],['NA',t('北美洲','North America')],['SA',t('南美洲','South America')],['AF',t('非洲','Africa')],['OC',t('大洋洲','Oceania')]];
const counts={}; for(const a of airports){counts[a.continent]=(counts[a.continent]||0)+1;}
const data=airports.map(a=>({i:a.iata,o:a.icao||'',zh:a.name_zh||'',en:a.name_en,c:a.city_en,ce:a.country_en||'',cn:countryZh[a.country_code]||a.country_en||'',cc:(a.country_code||'').toLowerCase(),main:a.type==='large_airport',ct:a.continent||'OT'}));
const hot=['PEK','PVG','CAN','SZX','HKG','SIN','LHR','JFK','CDG','DXB'];
const hotAirports=hot.map(c=>airports.find(a=>a.iata===c)).filter(Boolean);
const news=newsAll.filter(n=>n.lang===lang).slice(0,5);
const byC={}; for(const a of airports){const k=a.country_en||a.country_code;byC[k]={n:countryZh[a.country_code]||k,c:(byC[k]?.c||0)+1};}
const topC=Object.entries(byC).sort((x,y)=>y[1].c-x[1].c).slice(0,12);
const aname=a=>lang==='zh'?(a.name_zh||a.name_en):a.name_en;
const PIN='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>';
---
<Base title={t('机场查询_机场三字代码查询','Airport Lookup_IATA Codes')} lang={lang} description={t('全球机场 IATA 三字代码、ICAO 四字码查询，按大洲筛选。','Look up airport IATA/ICAO codes worldwide, filter by continent.')}>
<style>
:global(.apt-hero){background:linear-gradient(150deg,#1F8BF7 0%,#0A46A8 100%);border-radius:18px;padding:26px 22px 22px;margin:2px 0 18px;box-shadow:0 8px 24px rgba(11,76,184,.3);color:#fff}
:global(.apt-crumbs){font-size:13px;color:rgba(255,255,255,.85);margin-bottom:10px}
:global(.apt-crumbs a){color:#fff}
:global(.apt-hero h1){margin:0 0 6px;font-size:27px;letter-spacing:1px}
:global(.apt-hero .sub){margin:0 0 16px;opacity:.92;font-size:14px}
:global(.capsule){display:flex;background:#fff;border-radius:999px;padding:6px;box-shadow:0 4px 16px rgba(0,0,0,.16);max-width:560px}
:global(.capsule input){flex:1;min-width:0;border:0;outline:none;font-size:15.5px;padding:10px 16px;border-radius:999px;background:transparent}
:global(.capsule button){flex:none;border:0;background:var(--fb);color:#fff;font-size:15.5px;font-weight:700;padding:10px 30px;border-radius:999px;cursor:pointer}
:global(.capsule button:hover){background:var(--fb-dark)}
:global(.hotq){margin-top:12px;font-size:13.5px;color:rgba(255,255,255,.9);display:flex;flex-wrap:wrap;gap:8px;align-items:center}
:global(.hotq b){font-weight:600}
:global(.hotq a){color:#fff;background:rgba(255,255,255,.18);padding:4px 12px;border-radius:999px;font-size:13px}
:global(.hotq a:hover){background:#fff;color:var(--fb);text-decoration:none}
:global(.apt-cols){display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}
:global(.ctabs){display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 4px}
:global(.ctab){border:1px solid var(--line);background:#fff;color:var(--ink);font-size:14px;font-weight:600;padding:8px 16px;border-radius:999px;cursor:pointer}
:global(.ctab small){font-weight:400;color:var(--muted);margin-left:4px}
:global(.ctab.on){background:var(--fb);border-color:var(--fb);color:#fff}
:global(.ctab.on small){color:rgba(255,255,255,.85)}
:global(.pager){display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:18px 0 6px;align-items:center}
:global(.pg){min-width:36px;text-align:center;padding:7px 10px;border:1px solid var(--line);background:#fff;border-radius:9px;font-size:13.5px;color:var(--ink);cursor:pointer;font-weight:600}
:global(.pg.on){background:var(--fb);border-color:var(--fb);color:#fff}
:global(.pg:hover){border-color:var(--fb);color:var(--fb)}
:global(.pg.on:hover){color:#fff}
:global(.pg.dis){opacity:.4;pointer-events:none}
:global(.pginfo){font-size:13px;color:var(--muted);width:100%;text-align:center;margin-top:2px}
:global(.emptycard){background:#fff;border:1px solid var(--line);border-radius:16px;padding:34px;text-align:center;color:var(--muted)}
:global(.sidecard){background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
:global(.sidecard h3){margin:0 0 10px;font-size:15.5px;display:flex;align-items:center;gap:8px}
:global(.sidecard h3::before){content:"";width:4px;height:16px;border-radius:2px;background:var(--fb)}
:global(.sidelink){display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid #F4F6F8;font-size:14px;color:var(--ink)}
:global(.sidelink:last-child){border-bottom:0}
:global(a.sidelink:hover){color:var(--fb);text-decoration:none}
:global(.sflag){width:26px;height:18px;object-fit:cover;border-radius:4px;flex:none;box-shadow:0 1px 2px rgba(0,0,0,.15);background:#eef1f5}
:global(.sidechips){display:flex;flex-wrap:wrap;gap:7px}
:global(.sidechips button){font-size:13px;background:#F0F2F5;color:var(--ink);padding:5px 11px;border-radius:999px;border:0;cursor:pointer}
:global(.sidechips button:hover){background:var(--fb);color:#fff}
:global(.sidenews a){display:block;font-size:13.5px;color:var(--ink);padding:6px 0;border-bottom:1px solid #F4F6F8}
:global(.sidenews a:last-child){border-bottom:0}
:global(.sidenews a:hover){color:var(--fb);text-decoration:none}
:global(.sidenews span){display:block;font-size:12px;color:var(--muted)}
@media(max-width:900px){:global(.apt-cols){grid-template-columns:1fr}:global(.apt-side){display:grid;grid-template-columns:1fr 1fr;gap:14px}:global(.apt-side .sidecard){margin-bottom:0}}
@media(max-width:600px){:global(.apt-side){grid-template-columns:1fr}:global(.apt-hero h1){font-size:23px}:global(.capsule button){padding:10px 20px}}
</style>

<section class="apt-hero">
<div class="apt-crumbs"><a href={`/${lang}/`}>{t('首页','Home')}</a> › {t('机场查询','Airport Lookup')}</div>
<h1>{t('机场查询','Airport Lookup')}</h1>
<p class="sub">{t('全球机场 IATA 三字代码 · ICAO 四字码查询','Worldwide airport IATA / ICAO code lookup')}</p>
<div class="capsule"><input id="aq" type="search" placeholder={t('输入三字码 / 机场名 / 城市，如 PEK、北京','Code / airport / city, e.g. PEK, Beijing')} autocomplete="off" /><button id="ago">{t('查询','Search')}</button></div>
<div class="hotq"><b>{t('热门查询：','Popular:')}</b>{hot.map(c=><a href={`/${lang}/airport/${c.toLowerCase()}/`}>{c}</a>)}</div>
</section>

<div class="apt-cols">
<div class="apt-main">
<div class="ctabs" id="ctabs">
{CONT.map(([k,label])=><button class={'ctab'+(k==='all'?' on':'')} data-c={k}>{k==='all'?t('全部','All'):label}<small>{k==='all'?airports.length:(counts[k]||0)}</small></button>)}
</div>
<div class="listhead"><h2><span class="bar"></span><span id="ltitle">{t('全部机场','All Airports')}</span></h2>
<select class="sortsel" id="asort"><option value="d">{t('⇅ 默认排序','⇅ Default')}</option><option value="i">{t('⇅ 按三字码','⇅ By IATA')}</option><option value="c">{t('⇅ 按国家','⇅ By country')}</option></select></div>
<div id="alist"></div>
<div class="pager" id="apager"></div>
</div>
<aside class="apt-side">
<div class="sidecard"><h3>{t('热门机场','Popular Airports')}</h3>
{hotAirports.map(a=><a class="sidelink" href={`/${lang}/airport/${a.iata.toLowerCase()}/`}><img class="sflag" src={`/flags/${(a.country_code||'').toLowerCase()}.svg`} alt="" loading="lazy" /><span class="code sm">{a.iata}</span>{aname(a)}</a>)}
</div>
<div class="sidecard"><h3>{t('最新资讯','Latest News')}</h3><div class="sidenews">
{news.map(n=><a href={`/${lang}/news/${n.slug}/`}>{n.title}<span>{n.date}</span></a>)}
</div></div>
<div class="sidecard"><h3>{t('按国家','By Country')}</h3><div class="sidechips">
{topC.map(([k,v])=><button data-cc={k}>{v.n} ({v.c})</button>)}
</div></div>
</aside>
</div>

<script define:vars={{ DATA:data, lang, PIN }}>
const PER=15; let cont='all', q='', page=1, sort='d';
const $=id=>document.getElementById(id);
const T=(zh,en)=>lang==='zh'?zh:en;
const CL={all:T('全部','All'),AS:T('亚洲','Asia'),EU:T('欧洲','Europe'),NA:T('北美洲','North America'),SA:T('南美洲','South America'),AF:T('非洲','Africa'),OC:T('大洋洲','Oceania')};
function match(x){ const nq=q.trim().toLowerCase(); if(cont!=='all'&&x.ct!==cont)return false; if(!nq)return true; return [x.i,x.o,x.zh,x.en,x.c,x.cn,x.ce].join(' ').toLowerCase().includes(nq); }
function card(x){
  const url=`/${lang}/airport/${x.i.toLowerCase()}/`;
  const nm=lang==='zh'?(x.zh||x.en):x.en;
  const loc=lang==='zh'?`${x.cn} · ${x.c}`:`${x.c} · ${x.ce}`;
  return `<a class="apcard" href="${url}"><img class="flag" src="/flags/${x.cc}.svg" alt="" loading="lazy">`+
  `<span class="apinfo"><span class="nm">${nm}${x.main?`<i class="mainbadge">${T('主机场','Main airport')}</i>`:''}</span>`+
  `<span class="en">${x.en}</span><span class="loc">${PIN}${loc}</span></span>`+
  `<span class="apcode"><b>${x.i}</b><i>${x.o||''}</i></span><span class="go">›</span></a>`;
}
function render(){
  let list=DATA.filter(match);
  if(sort==='i')list=[...list].sort((a,b)=>a.i<b.i?-1:1);
  else if(sort==='c')list=[...list].sort((a,b)=>((lang==='zh'?a.cn:a.ce)+a.i)<((lang==='zh'?b.cn:b.ce)+b.i)?-1:1);
  const pages=Math.max(1,Math.ceil(list.length/PER));
  if(page>pages)page=pages;
  const s=(page-1)*PER, rows=list.slice(s,s+PER);
  $('alist').innerHTML=rows.length?rows.map(card).join(''):`<div class="emptycard">${T('没有找到匹配的机场，换个关键词试试','No matching airports — try another keyword')}</div>`;
  $('ltitle').textContent=(cont==='all'?T('全部机场','All Airports'):CL[cont]+T('机场',' Airports'))+(q?` · “${q.trim()}”`:'')+`（${list.length}）`;
  let h=`<button class="pg${page===1?' dis':''}" data-p="${page-1}">${T('上一页','Prev')}</button>`;
  const win=[]; for(let p=1;p<=pages;p++){ if(p===1||p===pages||Math.abs(p-page)<=2) win.push(p); }
  let last=0; for(const p of win){ if(p-last>1)h+=`<span style="color:var(--muted)">…</span>`; h+=`<button class="pg${p===page?' on':''}" data-p="${p}">${p}</button>`; last=p; }
  h+=`<button class="pg${page===pages?' dis':''}" data-p="${page+1}">${T('下一页','Next')}</button>`;
  h+=`<span class="pginfo">${T('共','')}${list.length}${T(' 条',' results')} · ${T('第','Page')} ${page}/${pages} ${T('页','')}</span>`;
  $('apager').innerHTML=h;
}
$('apager').addEventListener('click',e=>{ const b=e.target.closest('button[data-p]'); if(!b||b.classList.contains('dis'))return; page=+b.dataset.p; render(); window.scrollTo({top:$('ctabs').offsetTop-140,behavior:'smooth'}); });
$('ctabs').addEventListener('click',e=>{ const b=e.target.closest('button.ctab'); if(!b)return; cont=b.dataset.c; page=1; document.querySelectorAll('#ctabs .ctab').forEach(x=>x.classList.toggle('on',x===b)); render(); });
$('asort').addEventListener('change',e=>{ sort=e.target.value; page=1; render(); });
function doSearch(v){ q=v; page=1; render(); }
$('aq').addEventListener('input',e=>doSearch(e.target.value));
$('ago').addEventListener('click',()=>doSearch($('aq').value));
document.querySelectorAll('[data-cc]').forEach(b=>b.addEventListener('click',()=>{ $('aq').value=b.dataset.cc; doSearch(b.dataset.cc); window.scrollTo({top:0,behavior:'smooth'}); }));
render();
</script>
</Base>
