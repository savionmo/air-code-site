---
interface Props { title: string; description?: string; lang?: 'zh'|'en'; }
const { title, description = '', lang = 'zh' } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(zh|en)/, '');
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="alternate" hreflang="zh" href={new URL(`/zh${path}`, Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site)} />
<link rel="icon" href="/favicon.svg" />
<style>
:root{--fb:#1877F2;--fb-dark:#166FE5;--fb-deep:#0A4DB3;--bg:#F0F2F5;--ink:#1C2B33;--muted:#65676B;--line:#E4E6EB}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--fb);text-decoration:none}a:hover{text-decoration:underline}
header{background:var(--fb);color:#fff;padding:10px 14px;position:sticky;top:0;z-index:20;box-shadow:0 1px 6px rgba(24,119,242,.35)}
header .row{max-width:980px;margin:0 auto;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
header a{color:#fff;font-weight:700}
.logo{display:flex;align-items:center;gap:7px;font-size:18px}
.logo .ic{display:inline-flex;width:28px;height:28px;border-radius:8px;background:#fff;color:var(--fb);align-items:center;justify-content:center;font-size:15px}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:14px}
nav a{opacity:.95;font-weight:400;padding:6px 10px;border-radius:8px}
nav a:hover{background:rgba(255,255,255,.16);text-decoration:none}
main{max-width:980px;margin:0 auto;padding:16px 12px 40px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;margin:10px 0;box-shadow:0 1px 2px rgba(0,0,0,.06)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.chip{display:inline-block;padding:6px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;margin:3px;font-size:14px;color:var(--ink)}
.chip:hover{border-color:var(--fb);color:var(--fb);text-decoration:none}
.chip.on{background:var(--fb);border-color:var(--fb);color:#fff}
input[type=search]{width:100%;padding:13px 14px;border:1px solid #CCD0D5;border-radius:10px;font-size:16px;outline:none}
input[type=search]:focus{border-color:var(--fb);box-shadow:0 0 0 3px rgba(24,119,242,.25)}
.btn{display:inline-block;background:var(--fb);color:#fff;border:0;padding:10px 18px;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer}
.btn:hover{background:var(--fb-dark);text-decoration:none}
.hero{background:linear-gradient(160deg,var(--fb) 0%,var(--fb-deep) 100%);color:#fff;border-radius:14px;padding:26px 18px;margin:6px 0 14px;box-shadow:0 2px 10px rgba(24,119,242,.3)}
.hero h1{margin:0 0 6px;font-size:26px}
.hero p{opacity:.92;margin:0 0 14px;font-size:14px}
.hero .box{background:#fff;border-radius:12px;padding:10px}
.tabs{display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap}
.tabs button{border:1px solid rgba(255,255,255,.5);background:transparent;color:#fff;padding:7px 14px;border-radius:999px;font-size:14px;cursor:pointer}
.tabs button.on{background:#fff;color:var(--fb);font-weight:700}
.code{font-size:22px;font-weight:800;color:var(--fb);letter-spacing:.5px}
table{width:100%;border-collapse:collapse;font-size:14px}td,th{border-bottom:1px solid #EFF1F4;padding:8px;text-align:left}
footer{max-width:980px;margin:0 auto;padding:20px 14px;color:var(--muted);font-size:13px}
.badge{display:inline-block;background:#E7F0FE;color:var(--fb);padding:2px 7px;border-radius:999px;font-size:12px;font-weight:600}
.muted{color:var(--muted)}.lang{margin-left:auto;font-size:13px}
.sec{font-size:18px;margin:22px 2px 8px}
@media(max-width:560px){.hero h1{font-size:21px}}
</style>
</head>
<body>
<header><div class="row">
<a class="logo" href={`/${lang}/`}><span class="ic">✈</span>AirCode</a>
<nav>
<a href={`/${lang}/airport/`}>{lang==='zh'?'机场三字码':'Airports'}</a>
<a href={`/${lang}/airline/`}>{lang==='zh'?'航空公司':'Airlines'}</a>
<a href={`/${lang}/aircraft/`}>{lang==='zh'?'飞机机型':'Aircraft'}</a>
<a href={`/${lang}/news/`}>{lang==='zh'?'资讯':'News'}</a>
</nav>
<span class="lang"><a href={`/zh${path}`}>中文</a> · <a href={`/en${path}`}>EN</a></span>
</div></header>
<main><slot /></main>
<footer>{lang==='zh'?'数据来源：OurAirports (public domain) / OpenFlights，仅供查询参考。':'Data: OurAirports (public domain) / OpenFlights, for reference only.'}</footer>
</body></html>
