---
interface Props { title: string; description?: string; lang?: 'zh'|'en'; }
const { title, description = '', lang = 'zh' } = Astro.props;
const rawPath = Astro.url.pathname;
const path = rawPath.replace(/^\/(zh|en)/, '') || '/';
const t = (zh:string,en:string)=> lang==='zh'?zh:en;
const nav = [
  { href:`/${lang}/airport/`, zh:'机场三字码', en:'Airports' },
  { href:`/${lang}/airline/`, zh:'航空公司', en:'Airlines' },
  { href:`/${lang}/freighter/`, zh:'货机机型', en:'Freighters' },
  { href:`/${lang}/cargo/`, zh:'货机资料', en:'Cargo Data' },
  { href:`/${lang}/news/`, zh:'资讯', en:'News' },
];
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="alternate" hreflang="zh" href={new URL(`/zh${path}`, Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site)} />
<link rel="icon" href="/favicon.svg" />
<style is:global>
:root{--fb:#1877F2;--fb-dark:#1466D8;--fb-deep:#0A46A8;--bg:#F0F2F5;--ink:#17242F;--muted:#65676B;--line:#E3E6EA;--r:14px}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--ink);line-height:1.6}
h1,h2,h3{line-height:1.35}
a{color:var(--fb);text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%}
/* ===== header ===== */
.top{position:sticky;top:0;z-index:50;background:linear-gradient(135deg,#1F8BF7 0%,var(--fb) 55%,var(--fb-deep) 100%);box-shadow:0 2px 14px rgba(10,70,168,.35)}
.top .wrap{max-width:1020px;margin:0 auto;padding:9px 14px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:9px;color:#fff;font-weight:800;font-size:19px;letter-spacing:.3px}
.brand:hover{text-decoration:none}
.brand .pl{width:32px;height:32px;border-radius:10px;background:#fff;color:var(--fb);display:inline-flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.menu{display:flex;gap:2px;flex-wrap:wrap}
.menu a{color:#fff;font-size:14px;padding:7px 12px;border-radius:999px;opacity:.94;font-weight:500}
.menu a:hover{background:rgba(255,255,255,.18);text-decoration:none;opacity:1}
.langsel{margin-left:auto;display:flex;align-items:center;gap:4px;font-size:13px}
.langsel a{color:#fff;opacity:.8;padding:5px 10px;border-radius:999px}
.langsel a.on,.langsel a:hover{background:rgba(255,255,255,.22);opacity:1;text-decoration:none;font-weight:700}
/* ===== layout ===== */
main{max-width:1020px;margin:0 auto;padding:18px 14px 52px}
/* ===== crumbs & page head ===== */
.crumbs{font-size:13px;color:var(--muted);margin:2px 0 12px}
.crumbs a{color:var(--muted)}
.crumbs a:hover{color:var(--fb)}
.crumbs .sep{margin:0 7px;opacity:.55}
.phead{margin:4px 0 6px}
.phead h1{margin:0 0 5px;font-size:25px;letter-spacing:.5px}
.phead p{margin:0;color:var(--muted);font-size:14px}
/* ===== section head (seabay-style: title + more) ===== */
.sec-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:26px 2px 10px}
.sec-head h2{margin:0;font-size:18px;letter-spacing:.3px;display:flex;align-items:center;gap:8px}
.sec-head h2::before{content:"";width:4px;height:18px;border-radius:2px;background:var(--fb)}
.more{font-size:13.5px;color:var(--fb);font-weight:600;white-space:nowrap}
.more:hover{text-decoration:underline}
/* ===== code badge ===== */
.code{display:inline-flex;align-items:center;justify-content:center;min-width:56px;background:var(--fb);color:#fff;font-weight:800;font-size:15px;letter-spacing:1.5px;padding:7px 11px;border-radius:9px;box-shadow:inset 0 -2px 0 rgba(0,0,0,.12)}
.code.sm{min-width:48px;font-size:13px;letter-spacing:1px;padding:5px 9px;border-radius:8px}
.code.ghost{background:#E7F0FE;color:var(--fb);box-shadow:none}
/* ===== row lists ===== */
.rows{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.06)}
.row{display:flex;align-items:center;gap:13px;padding:12px 15px;border-bottom:1px solid #F0F2F5}
.row:last-child{border-bottom:0}
a.row:hover{background:#F3F8FF;text-decoration:none}
a.row:hover .tt b{color:var(--fb)}
.row .tt{flex:1;min-width:0}
.row .tt b{display:block;font-size:15.5px;color:var(--ink);font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .tt span{display:block;font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
.row .go{flex:none;color:#C3CAD2;font-size:20px;line-height:1}
/* ===== A-Z sticky nav ===== */
.az{position:sticky;top:58px;z-index:30;background:rgba(240,242,245,.97);backdrop-filter:blur(6px);padding:9px 2px;margin:4px -2px 0;overflow-x:auto;white-space:nowrap;border-bottom:1px solid var(--line);scrollbar-width:none}
.az::-webkit-scrollbar{display:none}
.az a{display:inline-block;min-width:35px;text-align:center;padding:7px 9px;margin:2px;border-radius:9px;background:#fff;border:1px solid var(--line);font-size:13.5px;font-weight:700;color:var(--ink)}
.az a:hover{border-color:var(--fb);color:var(--fb);text-decoration:none;box-shadow:0 1px 4px rgba(24,119,242,.25)}
.letter-h{display:flex;align-items:center;gap:10px;margin:24px 2px 10px}
.letter-h .L{width:36px;height:36px;border-radius:11px;background:var(--ink);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:17px}
.letter-h .cnt{font-size:13px;color:var(--muted)}
/* ===== fold (details) ===== */
.fold{border-bottom:1px solid #F0F2F5}
.fold:last-child{border-bottom:0}
.fold summary{list-style:none;display:flex;align-items:center;gap:10px;padding:13px 15px;cursor:pointer;font-size:15px}
.fold summary::-webkit-details-marker{display:none}
.fold summary:hover{background:#F3F8FF}
.fold summary .cnt{margin-left:auto;font-size:12.5px;color:var(--muted);background:#F0F2F5;border-radius:999px;padding:2px 9px}
.fold-body{padding:4px 15px 14px;display:flex;flex-wrap:wrap;gap:7px}
.minichip{display:inline-block;background:#E7F0FE;color:var(--fb);font-weight:700;font-size:13px;letter-spacing:.5px;padding:5px 10px;border-radius:8px}
.minichip:hover{background:var(--fb);color:#fff;text-decoration:none}
/* ===== news rows ===== */
.newsrow{display:flex;gap:14px;padding:14px 15px;border-bottom:1px solid #F0F2F5;align-items:center}
.newsrow:last-child{border-bottom:0}
a.newsrow:hover{background:#F3F8FF;text-decoration:none}
a.newsrow:hover .tt b{color:var(--fb)}
.datebox{flex:none;width:54px;text-align:center;background:#E7F0FE;border-radius:11px;padding:8px 0;color:var(--fb)}
.datebox b{display:block;font-size:20px;line-height:1.15}
.datebox span{font-size:11px;opacity:.85}
.newsrow .tt{flex:1;min-width:0}
.newsrow .tt b{display:block;font-size:15.5px;color:var(--ink);font-weight:650;margin-bottom:3px}
.newsrow .tt p{margin:0;font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* ===== detail hero ===== */
.dhero{background:linear-gradient(140deg,#1F8BF7 0%,var(--fb-deep) 100%);border-radius:18px;color:#fff;padding:24px 22px;margin:2px 0 16px;box-shadow:0 8px 24px rgba(11,76,184,.3);display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.dhero .big{font-size:54px;font-weight:900;letter-spacing:4px;background:rgba(255,255,255,.13);border:1.5px solid rgba(255,255,255,.45);padding:10px 20px;border-radius:15px;line-height:1.1}
.dhero h1{margin:0 0 5px;font-size:22px}
.dhero p{margin:0;opacity:.92;font-size:14px}
/* ===== key-value card ===== */
.kv{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.06)}
.kvr{display:flex;gap:12px;padding:12px 17px;border-bottom:1px solid #F0F2F5;font-size:14.5px;align-items:baseline}
.kvr:last-child{border-bottom:0}
.kvr .k{flex:none;width:86px;color:var(--muted);font-size:13.5px}
/* ===== generic card / grid / chips (kept) ===== */
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:17px;margin:10px 0;box-shadow:0 1px 3px rgba(16,24,40,.06)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:11px}
.acard{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;display:flex;gap:12px;align-items:center;box-shadow:0 1px 3px rgba(16,24,40,.06)}
a.acard:hover{border-color:var(--fb);box-shadow:0 3px 10px rgba(24,119,242,.18);text-decoration:none;transform:translateY(-1px)}
.acard .acard-t{flex:1;min-width:0}
.acard .acard-t b{display:block;font-size:14.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.acard .acard-t i{display:block;font-style:normal;font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* 热门机场：桌面一行5个，手机一行2个 */
.flagrow{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.flagcard{position:relative;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.06);min-width:0}
.flagcard .sflag{display:block;width:100%;height:96px;object-fit:cover;background:#eef1f5}
.flagcard .fcode{position:absolute;right:8px;bottom:8px;background:#1877F2;color:#fff;font-weight:800;font-size:13px;letter-spacing:1px;padding:4px 10px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.25)}
a.flagcard:hover{border-color:var(--fb);box-shadow:0 3px 10px rgba(24,119,242,.18);text-decoration:none}
@media(max-width:600px){.flagrow{grid-template-columns:repeat(2,1fr);gap:10px}.flagcard .sflag{height:84px}}
/* 热门航司：任何宽度都是一行2个 */
.hot2{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}
.hot2 .row{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:0 1px 3px rgba(16,24,40,.06);min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{display:inline-block;padding:7px 13px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:14px;color:var(--ink);font-weight:600}
.chip:hover{border-color:var(--fb);color:var(--fb);text-decoration:none;box-shadow:0 1px 4px rgba(24,119,242,.2)}
.badge{display:inline-block;background:#E7F0FE;color:var(--fb);padding:2px 8px;border-radius:999px;font-size:12px;font-weight:700}
.muted{color:var(--muted)}
/* ===== 5688-style airport cards (shared by list + detail related) ===== */
.apcard{display:flex;align-items:center;gap:14px;background:#fff;border:1.5px solid transparent;border-radius:16px;padding:16px;margin:0 0 12px;box-shadow:0 1px 4px rgba(16,24,40,.07)}
a.apcard:hover{border-color:var(--fb);text-decoration:none;box-shadow:0 4px 16px rgba(24,119,242,.16)}
.apcard .flag{width:64px;height:44px;object-fit:cover;border-radius:8px;flex:none;box-shadow:0 1px 3px rgba(0,0,0,.18);background:#eef1f5}
.apinfo{flex:1;min-width:0}
.apinfo .nm{font-size:16.5px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:8px;flex-wrap:wrap;line-height:1.35}
.mainbadge{font-style:normal;font-size:12px;font-weight:700;color:#F59300;background:#FFF4E0;padding:3px 9px;border-radius:7px;white-space:nowrap}
.apinfo .en{display:block;color:#9AA1AB;font-size:13px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.apinfo .loc{display:flex;align-items:center;gap:5px;color:#9AA1AB;font-size:13px;margin-top:4px}
.apinfo .loc svg{width:14px;height:14px;flex:none}
.apcode{text-align:right;flex:none}
.apcode b{display:block;font-size:24px;font-weight:800;letter-spacing:1px;color:var(--ink)}
.apcode i{font-style:normal;font-size:12.5px;color:#9AA1AB;letter-spacing:1px}
a.apcard:hover .apcode b{color:var(--fb)}
.apcard .go{flex:none;width:34px;height:34px;border-radius:50%;background:#F4F6F8;color:#9AA1AB;display:flex;align-items:center;justify-content:center;font-size:18px}
a.apcard:hover .go{background:var(--fb);color:#fff}
.listhead{display:flex;align-items:center;justify-content:space-between;margin:22px 0 14px;gap:10px}
.listhead h2{font-size:20px;margin:0;display:flex;align-items:center;gap:10px}
.listhead h2 .bar{width:5px;height:22px;border-radius:3px;background:var(--fb);display:inline-block}
.sortsel{border:1.5px solid var(--line);border-radius:12px;padding:8px 12px;font-size:13.5px;color:var(--muted);background:#fff;cursor:pointer;flex:none}
@media(max-width:520px){.apcard .flag{width:48px;height:34px;gap:10px}.apcard{gap:10px;padding:13px}.apcode b{font-size:20px}.apinfo .nm{font-size:15px}}
.sec{font-size:18px;margin:24px 2px 10px}
/* ===== hero & search ===== */
.hero{background:linear-gradient(160deg,#1F8BF7 0%,var(--fb-deep) 100%);color:#fff;border-radius:18px;padding:30px 22px 24px;margin:4px 0 8px;box-shadow:0 8px 24px rgba(11,76,184,.3)}
.hero h1{margin:0 0 7px;font-size:27px;letter-spacing:.5px}
.hero .sub{opacity:.93;margin:0 0 16px;font-size:14.5px}
.tabs{display:flex;gap:7px;margin:0 0 12px;flex-wrap:wrap}
.tabs button{border:1.5px solid rgba(255,255,255,.55);background:transparent;color:#fff;padding:7px 16px;border-radius:999px;font-size:14px;cursor:pointer;font-weight:600}
.tabs button.on{background:#fff;color:var(--fb);border-color:#fff}
.searchbox{background:#fff;border-radius:13px;padding:12px;box-shadow:0 4px 14px rgba(0,0,0,.12)}
.searchbox .srow{display:flex;gap:10px}
.searchbox .srow input{flex:1;min-width:0}
.sbtn{background:var(--fb);color:#fff;border:0;padding:0 28px;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;white-space:nowrap;transition:background .25s,transform .15s}
.sbtn:hover{background:linear-gradient(135deg,#1877F2,#00BFFF)}
.sbtn:active{transform:scale(.97)}
/* 全站搜索框统一为首页风格 */
.capsule{display:flex;gap:10px;background:#fff;border-radius:13px;padding:12px;box-shadow:0 4px 14px rgba(0,0,0,.12);max-width:640px}
.capsule input{flex:1;min-width:0;padding:13px 14px;border:1.5px solid #D5DAE0;border-radius:10px;font-size:16px;outline:none;background:#F8F9FB}
.capsule input:focus{border-color:var(--fb);box-shadow:0 0 0 3px rgba(24,119,242,.22);background:#fff}
.capsule button{flex:none;background:var(--fb);color:#fff;border:0;padding:0 28px;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;white-space:nowrap;transition:background .25s,transform .15s}
.capsule button:hover{background:linear-gradient(135deg,#1877F2,#00BFFF)}
.capsule button:active{transform:scale(.97)}
@media(max-width:600px){.capsule button{padding:0 18px;font-size:15px}}
input[type=search]{width:100%;padding:13px 14px;border:1.5px solid #D5DAE0;border-radius:10px;font-size:16px;outline:none;background:#F8F9FB}
input[type=search]:focus{border-color:var(--fb);box-shadow:0 0 0 3px rgba(24,119,242,.22);background:#fff}
.hero .hint{margin:10px 2px 0;font-size:12.5px;opacity:.85}
.btn{display:inline-block;background:var(--fb);color:#fff;border:0;padding:10px 20px;border-radius:9px;font-size:15px;font-weight:700;cursor:pointer}
.btn:hover{background:var(--fb-dark);text-decoration:none;color:#fff}
/* search results (JS-rendered, unscoped) */
:global(.sr){margin-top:4px}
:global(.sr-item){display:flex;align-items:center;gap:11px;padding:9px 4px;border-bottom:1px solid #EDF0F4}
:global(.sr-item:last-child){border-bottom:0}
:global(.sr-item .tt){flex:1;min-width:0;color:var(--ink);font-size:14.5px;font-weight:600}
:global(.sr-item .tt:hover){color:var(--fb)}
:global(.sr-item .meta){display:block;font-weight:400;font-size:12.5px;color:var(--muted)}
/* ===== article ===== */
.article{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px 24px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
.article h1{margin:0 0 8px;font-size:24px}
.article .meta{color:var(--muted);font-size:13.5px;margin:0 0 18px;padding-bottom:14px;border-bottom:1px solid #F0F2F5}
.article p{font-size:15.5px;margin:0 0 14px}
/* ===== footer ===== */
footer{background:#fff;border-top:1px solid var(--line);margin-top:34px}
footer .fgrid{max-width:1020px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:20px;padding:28px 14px 18px}
footer h4{margin:0 0 9px;font-size:14px}
footer ul{list-style:none;margin:0;padding:0;font-size:13.5px}
footer li{margin:6px 0}
footer a{color:var(--muted)}
footer a:hover{color:var(--fb)}
.copy{border-top:1px solid var(--line);padding:13px 14px;text-align:center;color:var(--muted);font-size:12.5px;max-width:1020px;margin:0 auto}
table{width:100%;border-collapse:collapse;font-size:14px}
td,th{border-bottom:1px solid #EFF1F4;padding:9px;text-align:left}
@media(max-width:600px){
  .hero{padding:24px 16px 20px}.hero h1{font-size:22px}
  .dhero .big{font-size:42px;padding:8px 15px}
  .dhero h1{font-size:19px}
  .phead h1{font-size:22px}
  .menu a{padding:6px 9px;font-size:13.5px}
  .article{padding:20px 17px}
}
</style>
</head>
<body>
<header class="top"><div class="wrap">
<a class="brand" href={`/${lang}/`}><span class="pl">✈</span>Airdocs</a>
<nav class="menu">{nav.map(n=><a href={n.href}>{lang==='zh'?n.zh:n.en}</a>)}</nav>
<span class="langsel"><a class={lang==='zh'?'on':''} href={`/zh${path}`}>中文</a><a class={lang==='en'?'on':''} href={`/en${path}`}>EN</a></span>
</div></header>
<main><slot /></main>
<footer>
<div class="fgrid">
<div><h4>Airdocs</h4><ul><li class="muted" style="font-size:13px">{t('机场三字代码 · 航空公司 · 机型资料查询','Airport codes · Airlines · Aircraft data')}</li></ul></div>
<div><h4>{t('查询','Lookup')}</h4><ul>
<li><a href={`/${lang}/airport/`}>{t('机场三字码','Airports')}</a></li>
<li><a href={`/${lang}/airline/`}>{t('航空公司','Airlines')}</a></li>
<li><a href={`/${lang}/freighter/`}>{t('货机机型','Freighters')}</a></li>
<li><a href={`/${lang}/cargo/`}>{t('货机资料','Cargo Data')}</a></li>
</ul></div>
<div><h4>{t('资讯','News')}</h4><ul><li><a href={`/${lang}/news/`}>{t('全部资讯','All news')}</a></li></ul></div>
<div><h4>{t('语言','Language')}</h4><ul><li><a href={`/zh${path}`}>中文</a></li><li><a href={`/en${path}`}>English</a></li></ul></div>
</div>
<div class="copy">{t('数据来源：OurAirports（公有领域）/ OpenFlights，仅供查询参考。','Data: OurAirports (public domain) / OpenFlights, for reference only.')}</div>
</footer>
</body></html>
