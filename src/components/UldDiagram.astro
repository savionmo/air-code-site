---
/* 原创集装器结构示意图(前视图): 按 dims_cm 真实比例绘制
   LD-3 系列(AKE/AKN/RKN)带标志性斜角; 集装板画为平板; 门用虚线标出
   数据标注与 JSON 完全一致 */
interface Props { code:string; aka?:string; dims:number[]; door?:number[]|null; profile:string; compact?:boolean; }
const { code, aka='', dims, door=null, profile='box', compact=false } = Astro.props;
const L=dims[0], W=dims[1], Hh=dims[2]||0;
const isSlab=profile==='slab';
const vh=isSlab?18:Hh;
const s=compact?Math.min(104/L,54/Math.max(vh,1)):Math.min(270/L,195/Math.max(vh,1));
const lw=L*s, lh=vh*s;
const x0=64, y0=248;
const top=y0-lh;
let pts='';
if(profile==='ld3'){
  const ch=lh*0.34;
  pts=`${x0},${y0} ${x0+lw},${y0} ${x0+lw},${top+ch} ${x0+lw-ch},${top} ${x0},${top}`;
}else{
  pts=`${x0},${y0} ${x0+lw},${y0} ${x0+lw},${top} ${x0},${top}`;
}
let doorR=null;
if(door&&door[0]>0&&door[1]>0&&!isSlab&&Hh>0){
  const dw=Math.min(door[0],L)*s, dh=Math.min(door[1],Hh)*s;
  doorR={x:x0+(lw-dw)/2, y:y0-dh, w:dw, h:dh};
}
const minX=x0-58, maxX=x0+lw+26;
const minY=top-(compact?30:40), maxY=y0+(compact?14:34);
const vbW=maxX-minX, vbH=maxY-minY;
const title=aka?`${code} (${aka})`:code;
const fs=compact?12:13.5, dc="#3A4A5C";
---
<svg viewBox={`${minX} ${minY} ${vbW} ${vbH}`} role="img" aria-label={title} style="width:100%;height:auto;display:block">
<text x={(minX+maxX)/2} y={minY+(compact?20:27)} text-anchor="middle" font-size={compact?15:21} font-weight="800" fill="#0A46A8">{title}</text>
<polygon points={pts} fill="#DCEBFF" stroke="#1F8BF7" stroke-width="1.8"/>
{doorR && <rect x={doorR.x} y={doorR.y} width={doorR.w} height={doorR.h} fill="#FFFFFF" fill-opacity="0.35" stroke="#0A46A8" stroke-width="1.6" stroke-dasharray="7 5"/>}
{!compact && (
<g>
<line x1={x0} y1={y0+9} x2={x0+lw} y2={y0+9} stroke="#8A9BAE" stroke-width="1"/>
<text x={x0+lw/2} y={y0+27} text-anchor="middle" font-size={fs} fill={dc}>{L} cm</text>
{!isSlab && Hh>0 && (
<g>
<line x1={x0-9} y1={y0} x2={x0-9} y2={top} stroke="#8A9BAE" stroke-width="1"/>
<text x={x0-15} y={(y0+top)/2+4} text-anchor="end" font-size={fs} fill={dc}>{Hh} cm</text>
</g>)}
</g>)}
</svg>
